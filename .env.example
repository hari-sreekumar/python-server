# Copy to .env and fill in. Never commit .env.

# LLM for the RAG chatbot and the pothole report (Groq, OpenAI-compatible)
GROQ_API_KEY=

# Optional overrides for the pothole service
# REPORT_MODEL=openai/gpt-oss-20b
# POTHOLE_WEIGHTS=models/pothole/yolo11s/weights/best.pt
# POTHOLE_DEPTH_MODEL=models/pothole/depth_model.json
# POTHOLE_WEIGHTS_URL=https://github.com/<you>/<repo>/releases/download/<tag>/best.pt

# Optional tracing (used by the chatbot)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
